{
  "openapi": "3.1.0",
  "info": {
    "title": "Manual fixture API",
    "version": "2026.08",
    "description": "A hand-authored OpenAPI contract mounted into the same Router."
  },
  "servers": [
    { "url": "http://127.0.0.1:4176/v1" }
  ],
  "paths": {
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List projects",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Project collection" } }
      },
      "post": {
        "operationId": "createProject",
        "summary": "Create a project",
        "requestBody": { "required": true },
        "responses": { "201": { "description": "Created project" } }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "summary": "Get one project",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Project" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    }
  }
}
